<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="org.eclipse.pde.core.requiredPlugins"/>
	<classpathentry kind="src" output="bin" path="src">
		<attributes>
			<attribute name="optional" value="true"/>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry exported="true" kind="lib" path="lib/CFLint.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/commons-io.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/jackson-annotations.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/jackson-core.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/jackson-databind.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/jackson-module-jaxb-annotations.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/slf4j-api.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/slf4j-simple.jar"/>
	<classpathentry kind="con" path="org.eclipse.m2e.MAVEN2_CLASSPATH_CONTAINER">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="output" path="bin"/>
</classpath>
