<?xml version="1.0" encoding="UTF-8"?>
<project
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
	xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.cfeclipse.cflint</groupId>
		<artifactId>cflint</artifactId>
		<version>1.3.0</version>
	</parent>
	<groupId>org.cfeclipse.cflint</groupId>
	<artifactId>org.cfeclipse.cflint.update-dev</artifactId>
	<version>1.0.0</version>
	<packaging>eclipse-repository</packaging>
	<properties>
		<site.suffix>-dev</site.suffix>
		<plugin.p2.dir>target/repository-merged</plugin.p2.dir>
		<merge.updates>false</merge.updates>
		<update.site.name>[dev] CFLint Update</update.site.name>
		<update.site.url>http://cfeclipse.org/cflint/update${site.suffix}</update.site.url>
		<update.site.github>http://github.com/cfeclipse/org.cfeclipse.cflint</update.site.github>
		<update.site.description>Development Build</update.site.description>
		<update.site.version>${project.version}</update.site.version>
		
		<cfparser-repo.url>http://cfeclipse.org/cfparser/update</cfparser-repo.url>
		<cfparser-dev-repo.url>http://cfeclipse.org/cfparser/update-dev</cfparser-dev-repo.url>
		<maven-antrun-plugin.version>3.2.0</maven-antrun-plugin.version>
	</properties>
	<repositories>
		<repository>
			<id>cfparser</id>
			<layout>p2</layout>
			<url>${cfparser-repo.url}</url>
		</repository>
		<repository>
			<id>cfparser-dev</id>
			<layout>p2</layout>
			<url>${cfparser-dev-repo.url}</url>
		</repository>
	</repositories>
	<profiles>
		<profile>
			<id>merge-updates</id>
			<activation>
				<property>
					<name>merge.updates</name>
					<value>true</value>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.eclipse.tycho.extras</groupId>
						<artifactId>tycho-p2-extras-plugin</artifactId>
						<version>${tycho-extras.version}</version>
						<executions>
							<execution>
								<id>add-to-update-site</id>
								<phase>package</phase>
								<goals>
									<goal>mirror</goal>
								</goals>
								<configuration>
									<source>
										<repository>
											<url>http://cfeclipse.org/cflint/update${site.suffix}</url>
										</repository>
									</source>
									<destination>${project.build.directory}/repository</destination>
									<append>true</append>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
	<build>
		<plugins>
			<plugin>
			  <groupId>org.eclipse.tycho</groupId>
			  <artifactId>tycho-p2-repository-plugin</artifactId>
			  <version>${tycho.version}</version>
			  <configuration>
			    <includeAllDependencies>true</includeAllDependencies>
			  </configuration>
			</plugin>

		
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>${maven-antrun-plugin.version}</version>
				<executions>
					<execution>
						<id>copy-webdocs-and-whatnot</id>
						<phase>verify</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<copy todir="${plugin.p2.dir}">
									<fileset dir="${project.build.directory}/repository"
										includes="*/**" excludes="target/**"/>
								</copy>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			
			
		</plugins>
	</build>

</project>
